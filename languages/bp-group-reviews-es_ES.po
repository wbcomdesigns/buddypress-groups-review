#. Plugin Name of the plugin
#: review-bp-grps.php
msgid "Wbcom Designs - BuddyPress Group Reviews"
msgstr "Wbcom Designs - Reseñas de Grupos de BuddyPress"

#. Plugin URI of the plugin
#: review-bp-grps.php
msgid "https://wbcomdesigns.com/contact/"
msgstr "https://wbcomdesigns.com/contact/"

#. Description of the plugin
#: review-bp-grps.php
msgid ""
"This plugin allows BuddyPress Members to give reviews to BuddyPress groups "
"on the site. The review form allows users to give text reviews and even rate "
"the group based on multiple criteria."
msgstr ""
"Este plugin permite que los miembros de BuddyPress hagan reseñas de grupos "
"de BuddyPress en el sitio. El formulario de reseña permite que los usuarios "
"envíen reseñas de texto e incluso califiquen el grupo según múltiples "
"criterios."

#. Author of the plugin
#: review-bp-grps.php
msgid "Wbcom Designs"
msgstr "Wbcom Designs"

#. Author URI of the plugin
