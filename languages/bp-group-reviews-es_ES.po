#: includes/admin/views/settings-emails.php:29
msgid "New Review Submitted for Your Group [group-name] on [site-name]"
msgstr "Nueva reseña enviada para tu grupo [group-name] en [site-name]"

#: includes/admin/views/settings-emails.php:30
msgid ""
"Hello [admin-name],<br><br>A new review has been submitted for your group "
"[group-name] by [user-name].<br><br>You can view and respond to the review "
"here: [review-link]<br><br>Thank you for creating a space where members can "
"share their experiences!<br><br>Best regards,<br>The [site-name] Team"
msgstr ""
"Hola [admin-name],<br><br>Una nueva reseña ha sido enviada para tu grupo "
"[group-name] por [user-name].<br><br>Puedes ver y responder a la reseña "
"aquí: [review-link]<br><br>¡Gracias por crear un espacio donde los miembros "
"pueden compartir sus experiencias!<br><br>Saludos cordiales,<br>El equipo de "
"[site-name]"

#: includes/admin/views/settings-emails.php:32
msgid "Your Review for [group-name] on [site-name] Has Been Approved"
msgstr "Tu reseña para [group-name] en [site-name] ha sido aprobada"

#: includes/admin/views/settings-emails.php:33
msgid ""
"Hello [user-name],<br><br>Your review for [group-name] on [site-name] has "
"been approved and is now published.<br><br>Thank you for sharing your "
"thoughts with the community. View your review here: [review-"
"link]<br><br>Best regards,<br>The [site-name] Team"
msgstr ""
"Hola [user-name],<br><br>Tu reseña para [group-name] en [site-name] ha sido "
"aprobada y ahora está publicada.<br><br>Gracias por compartir tus "
"pensamientos con la comunidad. Ver tu reseña aquí: [review-"
"link]<br><br>Saludos cordiales,<br>El equipo de [site-name]"

#: includes/admin/views/settings-emails.php:35
msgid "Your Review for [group-name] on [site-name] Was Not Approved"
msgstr "Tu reseña para [group-name] en [site-name] no fue aprobada"

#: includes/admin/views/settings-emails.php:36
msgid ""
"Hello [user-name],<br><br>Your review for [group-name] on [site-name] was "
"not approved by the group administrator.<br><br>If you have questions about "
"our community guidelines, please contact the group admin.<br><br>Thank you "
"for your understanding.<br><br>Best regards,<br>The [site-name] Team"
msgstr ""
"Hola [user-name],<br><br>Tu reseña para [group-name] en [site-name] no fue "
"aprobada por el administrador del grupo.<br><br>Si tienes preguntas sobre "
"nuestras directrices comunitarias, ponte en contacto con el administrador "
"del grupo.<br><br>Gracias por tu comprensión.<br><br>Saludos cordiales,"
"<br>El equipo de [site-name]"

