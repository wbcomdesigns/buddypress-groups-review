#: includes/admin/views/settings-emails.php:29
msgid "New Review Submitted for Your Group [group-name] on [site-name]"
msgstr "Neue Bewertung für deine Gruppe [group-name] auf [site-name] eingereicht"

#: includes/admin/views/settings-emails.php:30
msgid "Hello [admin-name],<br><br>A new review has been submitted for your group [group-name] by [user-name].<br><br>You can view and respond to the review here: [review-link]<br><br>Thank you for creating a space where members can share their experiences!<br><br>Best regards,<br>The [site-name] Team"
msgstr "Hallo [admin-name],<br><br>Eine neue Bewertung für deine Gruppe [group-name] wurde von [user-name] eingereicht.<br><br>Du kannst die Bewertung hier ansehen und darauf antworten: [review-link]<br><br>Vielen Dank dafür, dass du einen Raum schaffst, in dem Mitglieder ihre Erfahrungen teilen können!<br><br>Viele Grüße,<br>Das [site-name] Team"

#: includes/admin/views/settings-emails.php:32
msgid "Your Review for [group-name] on [site-name] Has Been Approved"
msgstr "Deine Bewertung für [group-name] auf [site-name] wurde genehmigt"

#: includes/admin/views/settings-emails.php:33
msgid "Hello [user-name],<br><br>Your review for [group-name] on [site-name] has been approved and is now published.<br><br>Thank you for sharing your thoughts with the community. View your review here: [review-link]<br><br>Best regards,<br>The [site-name] Team"
msgstr "Hallo [user-name],<br><br>Deine Bewertung für [group-name] auf [site-name] wurde genehmigt und ist nun veröffentlicht.<br><br>Vielen Dank, dass du deine Gedanken mit der Gemeinschaft teilst. Sieh dir deine Bewertung hier an: [review-link]<br><br>Viele Grüße,<br>Das [site-name] Team"

#: includes/admin/views/settings-emails.php:35
msgid "Your Review for [group-name] on [site-name] Was Not Approved"
msgstr "Deine Bewertung für [group-name] auf [site-name] wurde nicht genehmigt"

#: includes/admin/views/settings-emails.php:36
msgid "Hello [user-name],<br><br>Your review for [group-name] on [site-name] was not approved by the group administrator.<br><br>If you have questions about our community guidelines, please contact the group admin.<br><br>Thank you for your understanding.<br><br>Best regards,<br>The [site-name] Team"
msgstr "Hallo [user-name],<br><br>Deine Bewertung für [group-name] auf [site-name] wurde vom Gruppenadministrator nicht genehmigt.<br><br>Falls du Fragen zu unseren Gemeinschaftsrichtlinien hast, kontaktiere bitte den Gruppenadministrator.<br><br>Danke für dein Verständnis.<br><br>Viele Grüße,<br>Das [site-name] Team"

