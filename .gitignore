.DS_Store
node_modules
npm-debug.log

# The build directory.
build
*.json

# JS translation files. The blanket *.json above was silently excluding these
# from the repo and therefore from every release zip, so wp_set_script_translations()
# had nothing to load and all JS strings fell back to English in every locale.
# Regenerate with `php bin/make-js-translations.php`. Keep them tracked.
!languages/*.json

# AutoVAP onboarding artifacts — keep tracked despite broad ignores above
!CLAUDE.md
!audit/
!audit/**
!audit/manifest.json
!audit/manifest.summary.json

# Release-gate config. The blanket *.json above was silently excluding these too,
# which is the same trap that already cost us languages/*.json and audit/*.json:
#   - composer.json pins the PHPStan + stub versions that composer.lock locks.
#     Without it `composer install` cannot run at all (Composer needs the root
#     manifest), so the PHPStan release gate was not reproducible locally and CI
#     silently fell back to resolving whatever was latest.
#   - .contract-audit-baseline.json records verified contract-audit exceptions
#     with their reasons; without it the audit re-flags known false positives on
#     every run and the gate reads red for no reason.
# Neither ships in the release zip. Keep them tracked.
!composer.json
!.contract-audit-baseline.json

# Composer dev dependencies (PHPStan + stubs). Not shipped.
# Anchored with a leading slash so this only matches the top-level Composer
# directory. Unanchored "vendor/" matched EVERY vendor dir at any depth,
# including admin/assets/js/vendor/ and admin/assets/css/vendor/, which silently
# ignored newly added third-party sources (e.g. selectize.js). The libraries
# already tracked there were unaffected only because .gitignore does not apply to
# files already in the index. Do not remove the leading slash.
/vendor/

# Build artifacts (zips are release outputs, not source).
dist/
