{
  "$schema": "https://wpmediaverse.com/schemas/wp-plugin-manifest-v2.json",
  "plugin": {
    "slug": "buddypress-groups-review",
    "name": "Wbcom Designs - BuddyPress Group Reviews",
    "version": "3.9.0",
    "version_note": "Plugin header (review-bp-grps.php:18), BGR_PLUGIN_VERSION (review-bp-grps.php:59) and package.json all agree on 3.9.0. Support floors raised to 'Requires at least: 6.5' (review-bp-grps.php:19) and 'Requires PHP: 8.0' (review-bp-grps.php:20) in 3.9.0.",
    "namespace": "global functions (bp_group_review_*, bgr_*) + classes BGR_*",
    "main_file": "review-bp-grps.php",
    "text_domain": "bp-group-reviews",
    "domain_path": "/languages",
    "requires": [
      "BuddyPress",
      "BuddyPress Groups component"
    ],
    "requires_wp": "6.5",
    "requires_php": "8.0",
    "extends": null,
    "extension_hook_consumed": null,
    "extension_hook_fired": null
  },
  "rest": {
    "namespaces": [
      "buddypress/v1",
      "bgr/v1"
    ],
    "endpoints": [
      {
        "namespace": "buddypress/v1",
        "route": "/groups/(?P<group_id>\\d+)/reviews",
        "methods": [
          "GET"
        ],
        "handler": "BGR_BP_REST_Integration::get_group_reviews",
        "permission": "__return_true (public)",
        "purpose": "List reviews for a group (args: group_id, page, per_page).",
        "source": "includes/bgr-bp-rest-integration.php:184"
      },
      {
        "namespace": "buddypress/v1",
        "route": "/groups/(?P<group_id>\\d+)/reviews",
        "methods": [
          "POST"
        ],
        "handler": "BGR_BP_REST_Integration::create_group_review",
        "permission": "is_user_logged_in",
        "purpose": "Create a review for a group (args: group_id, subject, description, ratings).",
        "source": "includes/bgr-bp-rest-integration.php:184"
      },
      {
        "namespace": "buddypress/v1",
        "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)",
        "methods": [
          "GET"
        ],
        "handler": "BGR_BP_REST_Integration::get_single_review",
        "permission": "__return_true (public)",
        "purpose": "Fetch a single review.",
        "source": "includes/bgr-bp-rest-integration.php:243"
      },
      {
        "namespace": "buddypress/v1",
        "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)",
        "methods": [
          "PUT/PATCH"
        ],
        "handler": "BGR_BP_REST_Integration::update_group_review",
        "permission": "BGR_BP_REST_Integration::update_review_permissions_check",
        "purpose": "Update a review.",
        "source": "includes/bgr-bp-rest-integration.php:243"
      },
      {
        "namespace": "buddypress/v1",
        "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)",
        "methods": [
          "DELETE"
        ],
        "handler": "BGR_BP_REST_Integration::delete_group_review",
        "permission": "BGR_BP_REST_Integration::delete_review_permissions_check",
        "purpose": "Delete a review.",
        "source": "includes/bgr-bp-rest-integration.php:243"
      },
      {
        "namespace": "bgr/v1",
        "route": "/groups/(?P<id>\\d+)/criteria",
        "methods": [
          "GET"
        ],
        "handler": "bgr_rest_get_group_criteria",
        "permission": "closure: group must exist; public group => is_user_logged_in; private/hidden => groups_is_user_member || manage_options",
        "purpose": "Get group rating criteria.",
        "source": "includes/bgr-group-criteria-ajax.php:304"
      },
      {
        "namespace": "bgr/v1",
        "route": "/groups/(?P<id>\\d+)/criteria",
        "methods": [
          "PUT/PATCH"
        ],
        "handler": "bgr_rest_update_group_criteria",
        "permission": "closure (bgr_user_can_manage_group_criteria)",
        "purpose": "Update group rating criteria.",
        "source": "includes/bgr-group-criteria-ajax.php:337"
      }
    ],
    "notes": "IMPORTANT: the REST surface spans TWO namespaces. 5 endpoints under 'buddypress/v1' come from 2 multi-method register_rest_route blocks in includes/bgr-bp-rest-integration.php (registered via BGR_BP_REST_Integration::register_bp_review_routes). 2 endpoints under 'bgr/v1' come from 2 single-method register_rest_route blocks in includes/bgr-group-criteria-ajax.php (registered via bgr_register_group_criteria_rest_routes on rest_api_init). 4 register_rest_route calls expand to 7 logical endpoints across HTTP methods. Separately, review data is attached to BP's own /groups response via the bp_rest_groups_prepare_value filter (includes/bgr-bp-rest-integration.php:39) - not a route of its own."
  },
