      "handler": "BGR_AJAX::bp_group_review_filter_ratings",
      "nonce": "ajax-nonce",
      "capability": "public (read-only render)",
      "purpose": "Filter/render widget member ratings. Scan bounded by bgr_filter_ratings_max_scan (default 500).",
      "source": "includes/bgr-ajax.php:53-54"
    },
    {
      "action": "bgr_save_group_criteria_settings",
      "handler": "bgr_ajax_save_group_criteria_settings",
      "nonce": "checked",
      "capability": "group-manage context (bgr_user_can_manage_group_criteria)",
