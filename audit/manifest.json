{
  "$schema": "https://wpmediaverse.com/schemas/wp-plugin-manifest-v2.json",
  "plugin": {
    "slug": "buddypress-groups-review",
    "name": "Wbcom Designs - BuddyPress Group Reviews",
    "version": "3.8.1",
    "version_note": "Plugin header + BGR_PLUGIN_VERSION say 3.8.1, but the dev branch is 3.9.0. Version constant not yet bumped for this release.",
    "namespace": "global functions (bp_group_review_*, bgr_*) + classes BGR_*",
    "main_file": "review-bp-grps.php",
    "text_domain": "bp-group-reviews",
    "domain_path": "/languages",
    "requires": ["BuddyPress", "BuddyPress Groups component"],
    "extends": null,
    "extension_hook_consumed": null,
    "extension_hook_fired": null
  },
  "rest": {
    "namespace": "buddypress/v1",
    "endpoints": [
      { "route": "/groups/(?P<group_id>\\d+)/reviews", "methods": ["GET"], "handler": "BGR_BP_REST_Integration::get_group_reviews", "permission": "__return_true (public)", "purpose": "List reviews for a group." },
      { "route": "/groups/(?P<group_id>\\d+)/reviews", "methods": ["POST"], "handler": "BGR_BP_REST_Integration::create_group_review", "permission": "is_user_logged_in", "purpose": "Create a review for a group." },
      { "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)", "methods": ["GET"], "handler": "BGR_BP_REST_Integration::get_single_review", "permission": "__return_true (public)", "purpose": "Fetch a single review." },
      { "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)", "methods": ["PUT/PATCH"], "handler": "BGR_BP_REST_Integration::update_group_review", "permission": "update_review_permissions_check", "purpose": "Update a review." },
      { "route": "/groups/(?P<group_id>\\d+)/reviews/(?P<review_id>\\d+)", "methods": ["DELETE"], "handler": "BGR_BP_REST_Integration::delete_group_review", "permission": "delete_review_permissions_check", "purpose": "Delete a review." },
      { "route": "/groups/(?P<id>\\d+)/criteria", "methods": ["GET"], "handler": "bgr_rest_get_group_criteria", "permission": "closure (group access check)", "purpose": "Get group rating criteria." },
      { "route": "/groups/(?P<id>\\d+)/criteria", "methods": ["PUT/PATCH"], "handler": "bgr_rest_update_group_criteria", "permission": "closure (bgr_user_can_manage_group_criteria)", "purpose": "Update group rating criteria." }
    ],
    "notes": "Routes registered under the buddypress namespace via 2 register_rest_route blocks in bgr-bp-rest-integration.php (multi-method) and 2 blocks in bgr-group-criteria-ajax.php. The 4 register_rest_route calls expand to 7 logical endpoints across HTTP methods."
  },
  "ajax": [
    { "action": "bp_group_review_save_admin_criteria_settings", "handler": "BGR_AJAX::bp_group_review_save_admin_criteria_settings", "nonce": "admin-ajax-nonce", "capability": "manage_options", "purpose": "Save admin rating-criteria settings." },
    { "action": "bp_group_review_save_admin_display_settings", "handler": "BGR_AJAX::bp_group_review_save_admin_display_settings", "nonce": "admin-ajax-nonce", "capability": "manage_options", "purpose": "Save admin display settings." },
    { "action": "bp_group_review_save_admin_general_settings", "handler": "BGR_AJAX::bp_group_review_save_admin_general_settings", "nonce": "admin-ajax-nonce", "capability": "manage_options", "purpose": "Save admin general settings." },
    { "action": "bp_group_review_accept_review (+nopriv)", "handler": "BGR_AJAX::bp_group_review_accept_review", "nonce": "ajax-nonce", "capability": "member context", "purpose": "Group-admin accepts a pending review." },
    { "action": "bp_group_review_deny_review (+nopriv)", "handler": "BGR_AJAX::bp_group_review_deny_review", "nonce": "ajax-nonce", "capability": "member context", "purpose": "Group-admin denies a pending review." },
    { "action": "bp_group_remove_review (+nopriv)", "handler": "BGR_AJAX::bp_group_remove_review", "nonce": "ajax-nonce", "capability": "member context", "purpose": "Remove a review." },
    { "action": "bp_group_submit_review (+nopriv)", "handler": "BGR_AJAX::bp_group_submit_review", "nonce": "ajax-nonce", "capability": "is_user_logged_in + group member", "purpose": "Member submits a new review." },
    { "action": "bp_group_review_admin_approve_review", "handler": "BGR_AJAX::bp_group_review_admin_approve_review", "nonce": "admin-ajax-nonce", "capability": "manage_options", "purpose": "Admin approves a review (publishes the CPT post)." },
    { "action": "bp_group_review_admin_deny_review", "handler": "BGR_AJAX::bp_group_review_admin_deny_review", "nonce": "admin-ajax-nonce", "capability": "manage_options", "purpose": "Admin denies a review (trashes the CPT post)." },
    { "action": "bp_group_review_filter_ratings (+nopriv)", "handler": "BGR_AJAX::bp_group_review_filter_ratings", "nonce": "ajax-nonce", "capability": "public", "purpose": "Filter/render widget member ratings." },
    { "action": "bgr_save_group_criteria_settings", "handler": "bgr_ajax_save_group_criteria_settings", "nonce": "checked", "capability": "group-manage context", "purpose": "Save per-group criteria settings." },
    { "action": "bgr_add_custom_criteria", "handler": "bgr_ajax_add_custom_criteria", "nonce": "checked", "capability": "manage context", "purpose": "Add a custom criterion." },
    { "action": "bgr_archive_custom_criteria", "handler": "bgr_ajax_archive_custom_criteria", "nonce": "checked", "capability": "manage context", "purpose": "Archive a custom criterion." },
    { "action": "bgr_delete_custom_criteria", "handler": "bgr_ajax_delete_custom_criteria", "nonce": "checked", "capability": "manage context", "purpose": "Delete a custom criterion." },
    { "action": "bgr_toggle_global_criteria", "handler": "bgr_ajax_toggle_global_criteria", "nonce": "checked", "capability": "manage context", "purpose": "Toggle a global criterion on/off." },
    { "action": "bgr_get_group_criteria", "handler": "bgr_ajax_get_group_criteria", "nonce": "checked", "capability": "group context", "purpose": "Fetch per-group criteria." },
    { "action": "wbcom_addons_cards", "handler": "Wbcom_Admin_Settings::wbcom_addons_cards_links", "nonce": "wbcom_admin_setting_nonce", "capability": "admin (wrapper)", "purpose": "OLD-wrapper: echo addon card markup. No DB write." }
  ],
